# Copy to .env and set DB_PASSWORD (for example: openssl rand -hex 24)
APP_ENV=development
ENABLE_DOCS=true
SESSION_TTL_MINUTES=60

DB_HOST=127.0.0.1
DB_PORT=3306   # change to 3307 if a local MySQL already uses 3306
DB_USER=eventhub
DB_PASSWORD=
DB_NAME=eventhub
DB_POOL_SIZE=10

# TLS is always on. In production leave DB_SSL_VERIFY=true and set DB_SSL_CA to your CA bundle.
# For local development only, DB_SSL_VERIFY=false accepts the container's self-signed certificate.
DB_SSL_VERIFY=false
DB_SSL_CA=
